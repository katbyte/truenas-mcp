{
  "Name": "System",
  "Tag": "system",
  "Operations": [
    {
      "Name": "SystemBootId",
      "OperationId": "system.boot_id",
      "Method": "CALL",
      "Path": "system.boot_id",
      "Description": "Returns a unique boot identifier.\n\nIt is supposed to be unique every system boot.",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "String"
        }
      },
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "system.boot_id",
        "NoAuth": true
      }
    },
    {
      "Name": "SystemDebug",
      "OperationId": "system.debug",
      "Method": "CALL",
      "Path": "system.debug",
      "Description": "Download a debug file.",
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "system.debug",
        "Job": true,
        "Read": true,
        "Roles": [
          "READONLY_ADMIN",
          "SHARING_ADMIN"
        ],
        "Downloadable": true
      }
    },
    {
      "Name": "SystemFeatureEnabled",
      "OperationId": "system.feature_enabled",
      "Method": "CALL",
      "Path": "system.feature_enabled",
      "Description": "Returns whether the `feature` is enabled or not",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Boolean"
        }
      },
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "system.feature_enabled",
        "Read": true,
        "Roles": [
          "READONLY_ADMIN",
          "SHARING_ADMIN",
          "SYSTEM_PRODUCT_READ"
        ]
      },
      "Arguments": [
        {
          "Name": "feature",
          "Argument": "feature",
          "Type": {
            "Type": "Reference",
            "ReferenceName": "SystemFeatureEnabledFeature"
          },
          "Required": true,
          "Description": "Feature to check for availability on this system."
        }
      ]
    },
    {
      "Name": "SystemHostId",
      "OperationId": "system.host_id",
      "Method": "CALL",
      "Path": "system.host_id",
      "Description": "Retrieve a hex string that is generated based\non the contents of the `/etc/hostid` file. This\nis a permanent value that persists across\nreboots/upgrades and can be used as a unique\nidentifier for the machine.",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "String"
        }
      },
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "system.host_id",
        "Read": true,
        "Roles": [
          "READONLY_ADMIN",
          "SHARING_ADMIN"
        ]
      }
    },
    {
      "Name": "SystemInfo",
      "OperationId": "system.info",
      "Method": "CALL",
      "Path": "system.info",
      "Description": "Returns basic system information.",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "SystemInfoAnswer"
        }
      },
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "system.info",
        "Read": true,
        "Roles": [
          "READONLY_ADMIN",
          "SHARING_ADMIN"
        ]
      }
    },
    {
      "Name": "SystemLicenseUpdate",
      "OperationId": "system.license_update",
      "Method": "CALL",
      "Path": "system.license_update",
      "Description": "Update license file",
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "system.license_update",
        "Roles": [
          "SYSTEM_PRODUCT_WRITE"
        ]
      },
      "Arguments": [
        {
          "Name": "license",
          "Argument": "license",
          "Type": {
            "Type": "String"
          },
          "Required": true,
          "Description": "License key to apply to the system."
        }
      ]
    },
    {
      "Name": "SystemProductType",
      "OperationId": "system.product_type",
      "Method": "CALL",
      "Path": "system.product_type",
      "Description": "Returns the type of the product",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "String"
        }
      },
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "system.product_type",
        "Read": true,
        "Roles": [
          "READONLY_ADMIN",
          "SHARING_ADMIN",
          "SYSTEM_PRODUCT_READ"
        ]
      }
    },
    {
      "Name": "SystemReady",
      "OperationId": "system.ready",
      "Method": "CALL",
      "Path": "system.ready",
      "Description": "Returns whether the system completed boot and is ready to use",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Boolean"
        }
      },
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "system.ready",
        "Read": true,
        "Roles": [
          "READONLY_ADMIN",
          "SHARING_ADMIN",
          "SYSTEM_GENERAL_READ",
          "SYSTEM_GENERAL_WRITE"
        ]
      }
    },
    {
      "Name": "SystemReboot",
      "OperationId": "system.reboot",
      "Method": "CALL",
      "Path": "system.reboot",
      "Description": "Reboots the operating system.\n\nEmits an \"added\" event of name \"system\" and id \"reboot\".",
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "system.reboot",
        "Job": true,
        "Roles": [
          "FULL_ADMIN"
        ]
      },
      "Arguments": [
        {
          "Name": "reason",
          "Argument": "reason",
          "Type": {
            "Type": "String"
          },
          "Required": true,
          "Description": "Reason for the system reboot."
        },
        {
          "Name": "options",
          "Argument": "options",
          "Type": {
            "Type": "Reference",
            "ReferenceName": "SystemRebootOptions"
          },
          "Description": "Options for controlling the reboot process."
        }
      ]
    },
    {
      "Name": "SystemReleaseNotesUrl",
      "OperationId": "system.release_notes_url",
      "Method": "CALL",
      "Path": "system.release_notes_url",
      "Description": "Returns the release notes URL for a version of SCALE.\n\n`version_str` str: represents a version to check against\n\nIf `version` is not provided, then the release notes URL will return\n    a link for the currently installed version of SCALE.",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "String"
        }
      },
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "system.release_notes_url",
        "Read": true,
        "Roles": [
          "READONLY_ADMIN",
          "SHARING_ADMIN",
          "SYSTEM_PRODUCT_READ"
        ]
      },
      "Arguments": [
        {
          "Name": "version_str",
          "Argument": "versionStr",
          "Type": {
            "Type": "String"
          },
          "Description": "Version string to get release notes for. `null` for current version."
        }
      ]
    },
    {
      "Name": "SystemShutdown",
      "OperationId": "system.shutdown",
      "Method": "CALL",
      "Path": "system.shutdown",
      "Description": "Shuts down the operating system.\n\nAn \"added\" event of name \"system\" and id \"shutdown\" is emitted when shutdown is initiated.",
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "system.shutdown",
        "Job": true,
        "Roles": [
          "FULL_ADMIN"
        ]
      },
      "Arguments": [
        {
          "Name": "reason",
          "Argument": "reason",
          "Type": {
            "Type": "String"
          },
          "Required": true,
          "Description": "Reason for the system shutdown."
        },
        {
          "Name": "options",
          "Argument": "options",
          "Type": {
            "Type": "Reference",
            "ReferenceName": "SystemShutdownOptions"
          },
          "Description": "Options for controlling the shutdown process."
        }
      ]
    },
    {
      "Name": "SystemState",
      "OperationId": "system.state",
      "Method": "CALL",
      "Path": "system.state",
      "Description": "Returns system state:\n\"BOOTING\" - System is booting\n\"READY\" - System completed boot and is ready to use\n\"SHUTTING_DOWN\" - System is shutting down",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "String"
        }
      },
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "system.state",
        "Read": true,
        "Roles": [
          "READONLY_ADMIN",
          "SHARING_ADMIN",
          "SYSTEM_GENERAL_READ",
          "SYSTEM_GENERAL_WRITE"
        ]
      }
    },
    {
      "Name": "SystemVersion",
      "OperationId": "system.version",
      "Method": "CALL",
      "Path": "system.version",
