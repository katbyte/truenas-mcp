    {
      "Name": "VmDeviceCreate",
      "OperationId": "vm.device.create",
      "Method": "CALL",
      "Path": "vm.device.create",
      "Description": "Create a new device for the VM of id `vm`.\n\nIf `attributes.dtype` is the `RAW` type and a new raw file is to be created, `attributes.exists` will be\npassed as false. This means the API handles creating the raw file and raises the appropriate exception if\nfile creation fails.\n\nIf `attributes.dtype` is of `DISK` type and a new Zvol is to be created, `attributes.create_zvol` will be\npassed as true with valid `attributes.zvol_name` and `attributes.zvol_volsize` values.",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "VmDeviceCreateAnswer"
        }
      },
      "ExpectedStatusCodes": null,
