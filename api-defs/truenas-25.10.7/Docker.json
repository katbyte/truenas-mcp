      "Name": "DockerBackup",
      "OperationId": "docker.backup",
      "Method": "CALL",
      "Path": "docker.backup",
      "Description": "Create a backup of existing apps.\n\nThis creates a backup of existing apps on the same pool in which docker is initialized.",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "String"
        }
      },
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "docker.backup",
        "Job": true,
        "Roles": [
          "DOCKER_WRITE"
        ]
      },
      "Arguments": [
        {
          "Name": "backup_name",
          "Argument": "backupName",
          "Type": {
            "Type": "String"
          },
          "Description": "Name for the backup or `null` to generate a timestamp-based name."
        }
      ]
    },
    {
      "Name": "DockerBackupToPool",
      "OperationId": "docker.backup_to_pool",
      "Method": "CALL",
      "Path": "docker.backup_to_pool",
      "Description": "Create a backup of existing apps on `target_pool`.\n\nThis creates a backup of existing apps on the `target_pool` specified. If this is executed multiple times,\nin the next iteration it will incrementally backup the apps that have changed since the last backup.\n\nNote: This will stop the docker service (which means current active apps will be stopped) and\nthen start it again after snapshot has been taken of the current apps dataset.",
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "docker.backup_to_pool",
        "Job": true,
        "Roles": [
          "DOCKER_WRITE"
        ]
      },
      "Arguments": [
        {
          "Name": "target_pool",
          "Argument": "targetPool",
          "Type": {
            "Type": "String"
          },
          "Required": true,
          "Description": "Name of the storage pool to backup Docker data to."
        }
      ]
    },
