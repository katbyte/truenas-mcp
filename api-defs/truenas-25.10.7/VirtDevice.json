      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "virt.device.gpu_choices",
        "Read": true,
        "Roles": [
          "READONLY_ADMIN",
          "SHARING_ADMIN",
          "VIRT_INSTANCE_READ",
          "VIRT_INSTANCE_WRITE"
        ]
      },
      "Arguments": [
        {
          "Name": "gpu_type",
          "Argument": "gpuType",
          "Type": {
            "Type": "Reference",
            "ReferenceName": "VirtDeviceGpuChoicesGpuType"
          },
          "Required": true,
          "Description": "Type of GPU virtualization to filter available choices."
        }
      ]
    },
    {
      "Name": "VirtDeviceImportDiskImage",
      "OperationId": "virt.device.import_disk_image",
      "Method": "CALL",
      "Path": "virt.device.import_disk_image",
      "Description": "Imports a specified disk image.\n\nUtilized qemu-img with the auto-detect functionality to auto-convert\nany supported disk image format to RAW -> ZVOL\n\nAs of this implementation it supports:\n\n- QCOW2\n- QED\n- RAW\n- VDI\n- VPC\n- VMDK\n\n`diskimg` is a required parameter for the incoming disk image\n`zvol` is the required target for the imported disk image",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Boolean"
        }
      },
      "ExpectedStatusCodes": null,
      "Call": {
        "Method": "virt.device.import_disk_image",
        "Job": true,
        "Roles": [
          "VIRT_INSTANCE_WRITE"
        ]
      },
      "Arguments": [
        {
          "Name": "virt_device_import_disk_image",
          "Argument": "virtDeviceImportDiskImage",
          "Type": {
            "Type": "Reference",
            "ReferenceName": "ImportDiskImage"
          },
          "Required": true,
          "Description": "VirtDeviceImportDiskImageArgs parameters."
        }
      ]
    },
